# App
NODE_ENV=development
PORT=5050
CLIENT_URL=
# Optional, comma-separated allowlist. Defaults to CLIENT_URL.
CORS_ORIGIN=

# Database
MONGODB_URI=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=
# Optional: lax (default) | strict | none (none requires https)
COOKIE_SAMESITE=
# Optional, production only: proxy hops in front of the API. 1 (default) = Vercel.
TRUST_PROXY=

# Admin account, created or updated by `npm run seed:admin` (never logged)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_TITLE=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional root folder of every upload (default: portfolio). Use a different one per site on a shared account.
CLOUDINARY_FOLDER=

# SMTP (optional for now)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
